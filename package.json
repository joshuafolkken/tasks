{
	"name": "tasks",
	"private": true,
	"version": "0.28.0",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=22.16.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=10.32.1",
			"onFail": "warn"
		}
	},
	"pnpm": {
		"overrides": {
			"esbuild": "^0.25.0",
			"cookie": "^0.7.0",
			"undici": "^7.18.2",
			"lodash": ">=4.17.23",
			"minimatch": ">=3.1.4",
			"flatted": ">=3.4.0"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"lefthook",
			"unrs-resolver",
			"workerd"
		]
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm && pnpm dlx @aikidosec/safe-chain@1.4.4 setup-ci",
		"postinstall": "lefthook install",
		"prepare": "pnpm gen && pnpm paraglide:compile && svelte-kit sync",
		"setup:security": "safe-chain setup",
		"dev": "vite dev",
		"dev:cloudflare": "pnpm build && wrangler dev --remote",
		"build": "vite build",
		"deploy": "pnpm build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"preview:ci": "wrangler d1 execute tasks-db --local --file=./drizzle/migrations/0000_nervous_thor_girl_ci.sql && wrangler dev --local .svelte-kit/cloudflare/_worker.js --port 4173",
		"preview:normal": "vite preview",
		"preview:stop": "kill-port 4173 || true",
		"check": "pnpm paraglide:compile && svelte-kit sync && svelte-fast-check --incremental",
		"check:ci": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && pnpm lint:prettier && pnpm lint:eslint",
		"lint:prettier": "prettier --check .",
		"lint:eslint": "eslint . --cache --cache-strategy content",
		"format": "svelte-kit sync && pnpm format:prettier && pnpm format:eslint",
		"format:prettier": "prettier --write .",
		"format:eslint": "eslint . --fix --cache --cache-strategy content",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"gen": "pnpm gen:pre && wrangler types",
		"gen:pre": "rm -f .svelte-kit/cloudflare/_worker.*",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
		"update:corepack": "corepack use pnpm@latest",
		"update:latest": "pnpm update --latest",
		"cspell:dot": "cspell . --dot",
		"check-commit-message": "tsx scripts/check-commit-message.ts",
		"prevent-main-commit": "tsx scripts/prevent-main-commit.ts",
		"git": "tsx scripts/git-workflow.ts",
		"version:minor": "tsx scripts/bump-version.ts minor",
		"version:major": "tsx scripts/bump-version.ts major",
		"version:patch": "tsx scripts/bump-version.ts patch",
		"lefthook:commit": "lefthook run pre-commit",
		"lefthook:push": "lefthook run pre-push",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"main:sync": "git checkout main && git pull",
		"main:merge": "git pull origin main"
	},
	"devDependencies": {
		"@aikidosec/safe-chain": "^1.4.4",
		"@chromatic-com/storybook": "^5.0.1",
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@inlang/paraglide-js": "^2.15.0",
		"@libsql/client": "^0.17.0",
		"@playwright/test": "^1.58.2",
		"@storybook/addon-a11y": "^10.2.19",
		"@storybook/addon-docs": "^10.2.19",
		"@storybook/addon-svelte-csf": "^5.0.11",
		"@storybook/addon-vitest": "^10.2.19",
		"@storybook/sveltekit": "^10.2.19",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^25.5.0",
		"@vitest/browser-playwright": "^4.1.0",
		"@vitest/coverage-v8": "^4.1.0",
		"cspell": "^9.7.0",
		"drizzle-kit": "^0.31.9",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-sonarjs": "^4.0.2",
		"eslint-plugin-storybook": "^10.2.19",
		"eslint-plugin-svelte": "^3.15.2",
		"eslint-plugin-unicorn": "^63.0.0",
		"globals": "^17.4.0",
		"kill-port": "^2.0.1",
		"lefthook": "^2.1.4",
		"mdsvex": "^0.12.7",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"storybook": "^10.2.19",
		"svelte": "^5.53.11",
		"svelte-check": "^4.4.5",
		"svelte-fast-check": "^0.4.5",
		"tailwindcss": "^4.2.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^8.0.0",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.1.0",
		"wrangler": "^4.73.0"
	},
	"dependencies": {
		"better-auth": "^1.5.5",
		"drizzle-orm": "^0.45.1"
	}
}
