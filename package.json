{
	"name": "tasks",
	"private": true,
	"version": "0.31.0",
	"type": "module",
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"engines": {
		"node": ">=22.16.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"onFail": "error"
		}
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		],
		"overrides": {
			"esbuild@<=0.24.2": ">=0.25.0",
			"cookie@<0.7.0": ">=0.7.0",
			"lodash@>=4.0.0 <=4.17.22": ">=4.17.23"
		}
	},
	"scripts": {
		"preinstall": "pnpm dlx @aikidosec/safe-chain setup-ci",
		"postinstall": "lefthook install",
		"prepare": "pnpm gen && pnpm paraglide:compile && svelte-kit sync",
		"dev": "vite dev",
		"dev:cloudflare": "pnpm build && wrangler dev --remote",
		"build": "vite build",
		"deploy": "pnpm build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"preview:ci": "wrangler d1 execute tasks-db --local --file=./drizzle/ci-bootstrap.sql && wrangler dev --local .svelte-kit/cloudflare/_worker.js --port 4173",
		"preview:normal": "vite preview",
		"preview:stop": "kill-port 4173 || true",
		"check": "svelte-kit sync && svelte-fast-check --incremental",
		"check:ci": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && pnpm lint:prettier && pnpm lint:eslint",
		"lint:prettier": "prettier --check .",
		"lint:eslint": "eslint . --cache --cache-strategy content",
		"format": "svelte-kit sync && pnpm format:prettier && pnpm format:eslint",
		"format:prettier": "prettier --write .",
		"format:eslint": "eslint . --fix --cache --cache-strategy content",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "kill-port 5173 4173 || true && playwright test",
		"test:e2e:smoke": "playwright test e2e/dash.test.ts e2e/demo.test.ts e2e/dash-guest.test.ts",
		"test:e2e:dash-core": "playwright test e2e/dash-ux.test.ts e2e/dash-inline-editor.test.ts e2e/dash.test.ts",
		"test:e2e:save-auth": "tsx scripts/save-playwright-auth-storage.ts",
		"test:e2e:save-auth:codegen": "playwright codegen --channel=chrome --user-data-dir=e2e/.auth/chrome-profile --save-storage=e2e/.auth/user.json http://localhost:5173",
		"gen": "pnpm gen:pre && wrangler types",
		"gen:pre": "rm -f .svelte-kit/cloudflare/_worker.*",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
		"latest": "pnpm latest:corepack && pnpm latest:update && pnpm audit",
		"latest:corepack": "corepack use pnpm@latest",
		"latest:update": "pnpm update --latest",
		"cspell:dot": "cspell . --dot",
		"check-commit-message": "tsx scripts/check-commit-message.ts",
		"prevent-main-commit": "tsx scripts/prevent-main-commit.ts",
		"git": "tsx scripts/git-workflow.ts",
		"version:minor": "tsx scripts/bump-version.ts minor",
		"version:major": "tsx scripts/bump-version.ts major",
		"version:patch": "tsx scripts/bump-version.ts patch",
		"lefthook:commit": "lefthook run pre-commit",
		"lefthook:push": "lefthook run pre-push",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"main:sync": "git checkout main && git pull",
		"main:merge": "git pull origin main",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.better-auth-cli.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:generate": "drizzle-kit generate",
		"db:apply:local": "wrangler d1 migrations apply tasks-db --local"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@chromatic-com/storybook": "^5.1.1",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@inlang/paraglide-js": "^2.15.1",
		"@libsql/client": "^0.17.2",
		"@playwright/test": "^1.59.1",
		"@storybook/addon-a11y": "^10.3.4",
		"@storybook/addon-docs": "^10.3.4",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.3.4",
		"@storybook/sveltekit": "^10.3.4",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.56.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.5.2",
		"@vitest/browser-playwright": "^4.1.2",
		"@vitest/coverage-v8": "^4.1.2",
		"better-auth": "~1.5.6",
		"cspell": "^9.7.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-sonarjs": "^4.0.2",
		"eslint-plugin-storybook": "^10.3.4",
		"eslint-plugin-svelte": "^3.17.0",
		"eslint-plugin-unicorn": "^64.0.0",
		"globals": "^17.4.0",
		"kill-port": "^2.0.1",
		"lefthook": "^2.1.4",
		"mdsvex": "^0.12.7",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"storybook": "^10.3.4",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.6",
		"svelte-fast-check": "^0.4.5",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0",
		"vite": "^8.0.5",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.2",
		"vitest-browser-svelte": "^2.1.0",
		"wrangler": "^4.80.0"
	},
	"dependencies": {
		"fractional-indexing": "^3.2.0",
		"rrule": "^2.8.1",
		"svelte-dnd-action": "^0.9.69"
	}
}
